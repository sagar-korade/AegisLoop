# ============================================================
# AegisLoop Frontend Environment Variables
# ============================================================
#
# API Base URL:
# By default in local development, leave this empty (or commented out).
# The Vite development server proxy (vite.config.ts) automatically routes
# requests for /api and /health to http://127.0.0.1:8000 without CORS issues.
#
# If connecting directly to the backend without the Vite development proxy,
# set the origin of the FastAPI server (do NOT include /api/v1):
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
