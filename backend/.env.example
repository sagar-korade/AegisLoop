# ============================================================
# AegisLoop backend environment variables
# Copy to .env and fill in values. Never commit .env.
# Simulation mode works without any secrets.
# ============================================================

# Execution mode: "simulation" is the only supported value for MVP.
# "local_lab" requires Phase 9 lab implementation and explicit setup.
AEGISLOOP_MODE=simulation

# SQLite database path (relative to the backend/ directory)
AEGISLOOP_DATABASE_URL=sqlite:///./aegisloop.db

# CORS origins for the Vite dev server — restrict to expected local development origins
AEGISLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging level: DEBUG | INFO | WARNING | ERROR
AEGISLOOP_LOG_LEVEL=INFO

# Set to "true" only after Phase 9 lab isolation is verified.
# The backend refuses local-lab requests when this is false.
AEGISLOOP_ENABLE_LOCAL_LAB=false

# Application version (informational only; read at startup)
AEGISLOOP_VERSION=0.1.0
