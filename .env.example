# AegisLoop Root Environment Reference
# Configuration is modular by tier:
# - Backend configuration: copy backend/.env.example to backend/.env
# - Frontend configuration: copy frontend/.env.example to frontend/.env (optional; Vite proxy is default)
#
# Default backend settings for simulation mode:
# AEGISLOOP_MODE=simulation
# AEGISLOOP_DATABASE_URL=sqlite:///./aegisloop.db
# AEGISLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AEGISLOOP_LOG_LEVEL=INFO
# AEGISLOOP_ENABLE_LOCAL_LAB=false
# AEGISLOOP_VERSION=0.1.0
